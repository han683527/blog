# ===== 生产环境敏感配置 =====
# 使用方法:复制本文件为 .env,再填写真实值。.env 已被 git 忽略,不会上传。

# MySQL root 密码(生产请换成强密码,不要再用 123456)
MYSQL_PASSWORD=ChangeMe_StrongPassword

# QQ 邮箱(注册验证码发信用,填 QQ 号邮箱)
MAIL_USERNAME=你的QQ号@qq.com
# QQ 邮箱授权码(QQ 邮箱设置里生成,不是登录密码)
MAIL_PASSWORD=你的QQ邮箱授权码

# JWT 密钥(至少32位随机字符,服务器上可用 openssl rand -hex 32 生成)
JWT_SECRET=请替换成一段32位以上的随机字符串
